# PostgreSQL connection string
# Get a free DB from: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/olfi?sslmode=require"

# JWT secret — change this to a long random string in production
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret-in-production"

# Node environment
NODE_ENV="development"
