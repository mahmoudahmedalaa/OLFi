{
  "expo": {
    "name": "OLFi",
    "slug": "buyout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/olfi-icon.png",
    "scheme": "buyout",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "buildNumber": "43",
      "bundleIdentifier": "com.mahmoudahmedalaa.buyout",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Authenticate securely with Face ID to access your financial data",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mahmoudahmedalaa.buyout",
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/olfi-splash-hq.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#011819",
          "dark": {
            "backgroundColor": "#011819"
          }
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db73324a-056c-4824-9690-fa732e105b9a"
      }
    },
    "owner": "mahmoudahmedalaa"
  }
}
