# ========================================
# OLFi — Root .gitignore
# ========================================

# OS
.DS_Store
Thumbs.db
*.swp
*~

# Editor
.vscode/
.idea/
*.sublime-*

# Dependencies
node_modules/
*/node_modules/

# Environment
.env
.env.*
!.env.example

# Agent / AI artifacts (session-specific, not source code)
.gemini/
.antigravityignore
.playwright-cli/
outputs/
YC Application/
.local-artifacts/

# Secrets & credentials
*.p12
*.p8
*.mobileprovision
*.keystore
*.jks
*.pem

# Build outputs and local tool state
.expo/
*/.expo/
dist/
*/dist/
.next/
*/.next/
out/
*/out/
build/
*/build/
coverage/
*/coverage/
*.tsbuildinfo

# Local Vercel link state
.vercel/
*/.vercel/

# Local Supabase link/cache state
supabase/.temp/*
!supabase/.temp/cli-latest

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
